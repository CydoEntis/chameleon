# The Windows Terminal adapter test derives both a CRLF and an LF fixture
# from this file at test time (see test/adapters/windows-terminal.test.ts).
# That only proves anything if the checked-in bytes are LF on every
# platform — core.autocrlf must not get a vote.
test/adapters/fixtures/settings.jsonc text eol=lf

# Same reasoning as settings.jsonc above, for the Oh My Posh adapter's own
# fixtures (see test/adapters/oh-my-posh.test.ts) — CHM-4 shipped broken
# because a fixture just like these was left unpinned: it passed in the
# worktree that wrote it and failed on a clean clone, where autocrlf gets a
# vote it must never have.
test/adapters/fixtures/oh-my-posh-config.omp.json text eol=lf
test/adapters/fixtures/profile.ps1 text eol=lf

# Same reasoning again, for the Herdr adapter's own fixture (see
# test/adapters/herdr.test.ts).
test/adapters/fixtures/herdr-config.toml text eol=lf

# Same reasoning again, for the Herdr adapter's own CHM-22 duplicate-key
# fixture (see test/adapters/herdr.test.ts).
test/adapters/fixtures/herdr-config-duplicate-key.toml text eol=lf

# Same reasoning again, for the Herdr adapter's own CHM-23 [ui] accent
# take-over fixture (see test/adapters/herdr.test.ts).
test/adapters/fixtures/herdr-config-ui-accent.toml text eol=lf

# The real, unmodified "chips" Oh My Posh community theme — vendored for
# CHM-16's "verified against a real, unmodified community theme" (see
# test/adapters/oh-my-posh.test.ts). Read-only in every test that uses it,
# but pinned for the same reason as the fixtures above.
test/adapters/fixtures/chips.omp.json text eol=lf

# Same reasoning again, for the Claude Code adapter's own hostile fixture
# (see test/adapters/claude-code.test.ts).
test/adapters/fixtures/claude-code-settings.jsonc text eol=lf

# The three sources vendored from outside the iTerm2 collection. Each one's
# SOURCE.txt claims it is copied unmodified from a pinned commit, and
# tools/external-scheme-sources.ts verifies the PaperColor port against
# PaperColor.vim on every build — both claims are about the checked-in bytes,
# so autocrlf must not get a vote here either.
vendor/papercolor-terminal-app/PaperColor-dark.terminal text eol=lf
vendor/papercolor-terminal-app/PaperColor-light.terminal text eol=lf
vendor/papercolor-theme/PaperColor.vim text eol=lf
vendor/tangotango/tangotango-theme.el text eol=lf

# The theme authors' own Alacritty exports, copied unmodified from a pinned
# commit like every other vendored source here.
vendor/cyberdream-nvim/*.toml text eol=lf
vendor/bamboo-nvim/*.toml text eol=lf
