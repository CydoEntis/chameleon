// Windows Terminal user configuration — hand edited, please don't nuke my comments.
{
    "$help": "https://aka.ms/terminal-documentation",
    "$schema": "https://aka.ms/terminal-profiles-schema",
    "copyOnSelect": false, // I like this off
    "theme": "legacy", // picked this from the theme picker ages ago
    "defaultProfile": "{61c54bbd-c2c6-5271-96e7-009a87ff44bf}",

    "profiles":
    {
        "defaults":
        {
            // shared appearance for every profile
            "fontFace": "Cascadia Mono",
            "colorScheme": "Campbell", // set the last time I opened settings
            "fontSize": 11,
            "padding": "8, 8, 8, 8",
        },
        "list":
        [
            {
                "guid": "{61c54bbd-c2c6-5271-96e7-009a87ff44bf}",
                "name": "Windows PowerShell",
                "commandline": "powershell.exe",
            }
        ]
    },

    "schemes": [
        {
            "name": "Campbell",
            "black": "#0c0c0c",
            "red": "#c50f1f",
            "green": "#13a10e",
            "yellow": "#c19c00",
            "blue": "#0037da",
            "purple": "#881798",
            "cyan": "#3a96dd",
            "white": "#cccccc",
            "brightBlack": "#767676",
            "brightRed": "#e74856",
            "brightGreen": "#16c60c",
            "brightYellow": "#f9f1a5",
            "brightBlue": "#3b78ff",
            "brightPurple": "#b4009e",
            "brightCyan": "#61d6d6",
            "brightWhite": "#f2f2f2",
            "background": "#0c0c0c",
            "foreground": "#cccccc",
            "cursorColor": "#ffffff",
            "selectionBackground": "#ffffff"
        }
    ],

    // keep the tab bar out of the way
    "alwaysShowTabs": true,
    "actions": []
}
