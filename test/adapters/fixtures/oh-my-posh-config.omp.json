// Oh My Posh config — hand edited, please don't nuke my comments.
{
    "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
    "version": 2,
    "palette": {
        "accent": "#89b4fa", // picked this from the theme picker ages ago
        "muted": "#6c7086"
    },
    "final_space": true,

    "blocks": [
        {
            "type": "prompt",
            "alignment": "left",
            "segments": [
                {
                    "type": "path",
                    "style": "plain",
                    "foreground": "p:accent",
                    "properties": {
                        "style": "full",
                    },
                },
                {
                    "type": "text",
                    "style": "plain",
                    "foreground": "p:muted",
                }
            ],
        }
    ],

    // keep the transient prompt on
    "transient_prompt": {
        "foreground": "p:accent",
    },
    "console_title_template": "{{ .Shell }}"
}
