{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "path",
          "style": "plain",
          "foreground": "p:accent",
          "template": "\\uf07c {{ .Path }}",
          "properties": {
            "style": "folder"
          }
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "p:success",
          "template": " \\ue725 {{ .HEAD }}"
        }
      ]
    },
    {
      "type": "rprompt",
      "segments": [
        {
          "type": "exit",
          "style": "plain",
          "foreground": "p:error",
          "template": "{{ .Meaning }}"
        },
        {
          "type": "time",
          "style": "plain",
          "foreground": "p:body",
          "template": " {{ .CurrentDate | date .Format }}"
        }
      ]
    }
  ]
}
