{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:accent",
          "template": "\\uf0e7"
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "p:body",
          "template": " {{ .Path }}",
          "properties": {
            "style": "folder"
          }
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "p:body",
          "template": " {{ .HEAD }}"
        }
      ]
    }
  ]
}
