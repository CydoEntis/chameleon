{
  "name": "@cydoentis/chameleon",
  "version": "0.0.0",
  "description": "One command retints your whole terminal - Windows Terminal, Oh My Posh and Herdr - from a single palette.",
  "keywords": ["terminal", "theme", "oh-my-posh", "windows-terminal", "herdr", "colorscheme"],
  "license": "MIT",
  "author": "CydoEntis",
  "repository": { "type": "git", "url": "git+https://github.com/CydoEntis/chameleon.git" },
  "type": "module",
  "engines": { "node": ">=20" },
  "bin": { "ch": "dist/cli.js", "chameleon": "dist/cli.js" },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "themes"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
