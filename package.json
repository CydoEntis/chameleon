{
  "name": "@cydoentis/chameleon",
  "version": "0.0.0",
  "description": "One command retints your whole terminal - Windows Terminal, Oh My Posh and Herdr - from a single palette.",
  "keywords": ["terminal", "theme", "oh-my-posh", "windows-terminal", "herdr", "colorscheme"],
  "license": "MIT",
  "author": "CydoEntis",
  "repository": { "type": "git", "url": "git+https://github.com/CydoEntis/chameleon.git" },
  "type": "module",
  "engines": { "node": ">=20" },
  "bin": { "chm": "dist/cli.js", "chameleon": "dist/cli.js" },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "themes", "prompts"],
  "scripts": {
    "build": "npm run lint:prompts && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:linux": "vitest run --config vitest.config.linux.ts",
    "test:darwin": "vitest run --config vitest.config.darwin.ts",
    "test:watch": "vitest",
    "generate:themes": "tsc -p tsconfig.tools.json && node .theme-pack-build/tools/build-theme-packs.js",
    "lint:prompts": "tsc -p tsconfig.tools.json && node .theme-pack-build/tools/lint-prompt-packs.js"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
